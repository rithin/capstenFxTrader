{
  "permissions": {
    "allow": [
      "Bash(make lint:*)",
      "Bash(make test:*)",
      "Bash(make logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
