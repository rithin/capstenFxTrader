# Copy to .env (make install does this automatically) and change the passwords.
# Local values only. Server secrets are managed separately (M11.4). Never commit .env.

POSTGRES_USER=capsten
POSTGRES_PASSWORD=capsten-local-pw

# Object storage (SeaweedFS S3 API)
S3_ACCESS_KEY=capsten
S3_SECRET_KEY=capsten-local-s3-secret

# API auth (used from M7.2)
JWT_SECRET=change-me-local-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-local-pw

# Broker (leave empty locally: TRADING_MODE=sandbox needs no credentials)
IB_USERNAME=
IB_PASSWORD=
